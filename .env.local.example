# 이 파일을 .env.local 로 복사해서 로컬 개발에 사용한다.
#   cp .env.local.example .env.local
#
# 배포 환경(App Hosting)에서는 이 값들을 쓰지 않는다.
# ADMIN_PASSWORD / SESSION_SECRET / MACRODROID_TOKEN 는 Secret Manager에서,
# 나머지는 apphosting.yaml 에서 주입된다.

# ─────────────────────────────────────────────────────────
# 로컬 개발: Firestore 에뮬레이터 사용
# 이 값이 설정되어 있으면 firebase-admin이 실제 Firestore 대신
# 에뮬레이터에 붙는다. 실데이터 오염과 Blaze 과금이 없다.
# `npm run emulators` 를 먼저 띄운 뒤 `npm run dev` 를 실행할 것.
# ─────────────────────────────────────────────────────────
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GOOGLE_CLOUD_PROJECT=albam-416fd

# ─────────────────────────────────────────────────────────
# 관리자 / MacroDroid (로컬 테스트용 값 — 실제 배포 값과 반드시 다르게)
# ─────────────────────────────────────────────────────────
ADMIN_PASSWORD=test1234
SESSION_SECRET=local-dev-session-secret-change-me-please-32chars
MACRODROID_TOKEN=local-dev-macrodroid-token

NEXT_PUBLIC_SITE_NAME=알밤 주문

# ─────────────────────────────────────────────────────────
# Firebase 웹 앱 설정 (PRD 제공값)
#
# 참고: 현재 이 앱은 브라우저에서 Firebase SDK를 사용하지 않는다.
# 모든 데이터 접근이 서버(firebase-admin)를 거치므로 아래 값은 지금 쓰이지 않는다.
# 나중에 클라이언트 측 기능(Analytics, Storage 직접 업로드 등)을 붙일 때를 위해 남겨둔다.
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBSqyVR6Jz_xJVLHTBCDu_gYCb8-nYTGRU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=albam-416fd.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=albam-416fd
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=albam-416fd.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=653376312477
NEXT_PUBLIC_FIREBASE_APP_ID=1:653376312477:web:61626c04a2385bd85bb074
